# --- Email (Gmail example) ---
# Create an App Password: Google Account > Security > 2-Step Verification > App passwords
EMAIL_SENDER=you@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_RECIPIENT=you@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# --- Google Sheets ---
# The ID from your sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# Path to your service account JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# --- Google Drive (predictive_model.py report uploads) ---
# Same service account as above (its Cloud project already has the Drive API
# enabled from the Sheets setup). Uploaded files are also shared with
# EMAIL_SENDER above so they show up in your own Drive, not just the service
# account's private space.
# Optional: a folder ID to file uploads under (share this folder with the
# service account's client_email, Editor access, same as the Sheet). If unset,
# files upload to the service account's own space and rely on the share step.
GOOGLE_DRIVE_FOLDER_ID=
